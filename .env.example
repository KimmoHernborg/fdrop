# Public URL of this service, no trailing slash.
# Register <BASE_URL>/auth/callback as the callback URL in Pocket ID.
BASE_URL=http://fdrop.localhost:3000
PORT=3000

# Where the SQLite database and uploaded files live.
DATA_DIR=./data

# Pocket ID (OpenID Connect)
OIDC_ISSUER=https://pocket-id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# How long uploads are kept, in days (fractions allowed). Applies to new uploads.
RETENTION_DAYS=7
# Maximum size of a single upload, in megabytes.
MAX_UPLOAD_MB=1024
# How long a sign-in lasts, in days.
SESSION_DAYS=30
# How often expired files and empty folders are swept.
CLEANUP_INTERVAL_MINUTES=15

# Development only: skip sign-in and act as a fake local user.
# The server refuses to start with this set when NODE_ENV=production.
# AUTH_DISABLED=1
